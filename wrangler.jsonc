// Cloudflare Workers 설정 (Workers로 만들었을 때만 쓰여요. Pages는 이 파일을 건너뛰어요.)
{
  // Cloudflare 화면의 Worker 이름과 똑같아야 해요.
  "name": "concertrecap2026",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    // /api/ 로 시작하는 주소만 코드가 처리해요. 화면 파일은 무료·무제한으로 바로 나가요.
    "run_worker_first": ["/api/*"]
  },
  // 중계 주소는 worker/index.js에 적혀 있어요.
  // 인증키(KOPIS_API_KEY)는 Cloudflare 화면의 Settings → Variables and Secrets에 Secret으로만 넣어요.
  // 대시보드에서 넣은 값이 배포할 때 지워지지 않게 해요.
  "keep_vars": true
}
